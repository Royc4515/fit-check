// fit-check-cutout: background removal on Cloudflare Images. See worker/README.md for what it does and how to deploy.
{
  "name": "fit-check-cutout",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "images": { "binding": "IMAGES" }
  // Secret, set once: `wrangler secret put WORKER_TOKEN` (the same value as CLOUDFLARE_CUTOUT_TOKEN in Supabase).
}
