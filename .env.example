# Every variable the code reads, grouped by where it is set. Names checked against the code on 2026-11-25.

# --- App: copy these to apps/mobile/.env.local (Expo reads .env files from its own project directory) ---
# Placeholders only: real values never go in the repo (Roy, 2026-11-25). Take them from the Supabase dashboard
# (Project Settings > API) or from the Vercel project's environment variables.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# Optional: public base URL of the R2 bucket with the garment images. Empty = images come from Supabase Storage.
EXPO_PUBLIC_R2_PUBLIC_URL=

# --- Edge Functions: set with `supabase secrets set NAME=value`, never in the app or in git ---
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY and SUPABASE_JWKS are provided by Supabase itself.
ANTHROPIC_API_KEY=
# Free-tier Gemini key: garment detection fallback.
GEMINI_API_KEY=
# Paid Gemini key: first choice for detection, required for redraw and try-on (capped in _shared/ai/budget.ts).
GEMINI_IMAGE_API_KEY=
# Modal worker (see worker/README.md). Without both, intake-cutout answers not_configured.
MODAL_CUTOUT_URL=https://<workspace>--fit-check-worker-cutter-cutout.modal.run
MODAL_WORKER_TOKEN=
# Cloudflare R2 for garment images (_shared/objects.ts). Without all five, functions use Supabase Storage.
R2_ACCOUNT_ID=
R2_BUCKET=fit-check-cutouts
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# Code for the temporary design-preview function (scheduled for removal, docs/TASKS.md).
DESIGN_PREVIEW_CODE=

# --- Scripts: export in your shell only, never in a file (scripts/seed-wardrobe.ts bypasses RLS) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
