# Copy to .env.local (gitignored). Both values are public by design: the anon/publishable key is protected by
# RLS, and it is the only secret-looking thing allowed in the app bundle (CLAUDE.md).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
